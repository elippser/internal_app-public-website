# Copiar a .env.local

# API de internal-laupser. De ahí sale la captura de leads del formulario
# público (POST /public/mkt/leads). Prod: https://api-internal.roombir.com
NEXT_PUBLIC_INTERNAL_API_URL=http://localhost:8600

# Base pública de este renderer (canonical / OG). Prod: https://roombir.com
NEXT_PUBLIC_SITE_URL=http://localhost:6300

# Cloudflare Turnstile (opcional) para el formulario de alta de /crear-cuenta.
# Es la site key PUBLICA; la secreta va del lado del API interno
# (LEADS_TURNSTILE_SECRET). Vacío = el formulario no muestra captcha y queda
# defendido por el resto del filtro (honeypot, reloj, techos por IP).
# Va como variable BUILDTIME en Coolify, como el resto de los NEXT_PUBLIC_*.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
